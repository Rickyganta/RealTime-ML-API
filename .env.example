APP_NAME=real-time-ml-recommendation-api
ENV=dev
POSTGRES_URL=postgresql+psycopg2://recommender:recommender@localhost:5432/recommender
# Optional: same as POSTGRES_URL (Railway often provides DATABASE_URL only). postgres:// is normalized automatically.
# DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
AB_SALT=portfolio-project-salt
DEFAULT_HYBRID_WEIGHT_CF=0.6
MODEL_VERSION=v1
RATE_LIMIT_PER_MINUTE=100
LOADTEST_BYPASS_TOKEN=
CACHE_TTL_SECONDS=300
# Optional path to ml-latest-small (movies.csv / ratings.csv); default matches repo layout.
# MOVIELENS_PATH=data/ml-latest-small
